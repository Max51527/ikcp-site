# ⚠ CONSTAT EMPIRIQUE (2026-07-02, curl live sur MISS) : pour les fichiers
# .js, Cloudflare Pages FORCE un plancher max-age=14400 ('no-cache' et
# 'max-age=0' sont réécrits en 14400 ; 'public'/'must-revalidate'/'immutable'
# passent, et max-age>14400 type immutable 1 an est honoré). Les .json
# acceptent max-age=0. Les anciennes règles 'no-cache' n'ont donc JAMAIS
# été actives. Toujours vérifier via curl -sI (avec ?cachebust=) après
# déploiement. L'anti-JS-périmé est assuré par le SW stampé SHA
# (CI deploy-pages) + query-versioning ?v= des widgets — pas par _headers.

# Modules JS de l'espace membre : toujours revalider (ETag → 304 si inchangé).
# Code correctness-critical (Marcel, cockpit) — revalidation systématique.
/app/js/*
  Cache-Control: public, max-age=0, must-revalidate

# Librairies vendor auto-hébergées (Alpine/marked/fonts) : cache long (statiques).
/assets/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# Icônes et images statiques : 7 jours (noms stables, contenu quasi immuable).
/icons/*
  Cache-Control: public, max-age=604800

# Manifest PWA : 24 h.
/manifest.json
  Cache-Control: public, max-age=86400

# Service workers + version.json : toujours frais (propagation immédiate
# des déploiements ; les SW sont stampés SHA par le CI).
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
/app/sw.js
  Cache-Control: public, max-age=0, must-revalidate
/version.json
  Cache-Control: public, max-age=0, must-revalidate

# ════════════════════════════════════════════════════════════════════
#  Sécurité — defense-in-depth sur toutes les pages
#  connect-src verrouillé = même si une XSS passait, le jeton ne peut pas
#  être exfiltré ailleurs que vers nos propres workers. object-src/base-uri/
#  frame-ancestors/form-action ferment plugins, base-tag, clickjacking, vol de form.
#  ('unsafe-inline'/'unsafe-eval' restent nécessaires : l'app a des scripts
#   inline + onclick + libs (Chart/Mermaid) — la vraie protection est connect-src.)
# ════════════════════════════════════════════════════════════════════
#  Framing : SAMEORIGIN (et non DENY) — nécessaire à l'Atelier (/app/atelier),
#  qui affiche nos propres pages en aperçu dans une iframe. La protection
#  anti-clickjacking reste ENTIÈRE : aucun site tiers ne peut encadrer ikcp.eu,
#  seules nos propres pages le peuvent (frame-ancestors 'self').
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(self), microphone=(self), payment=(self)
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://*.maxime-ead.workers.dev https://recherche-entreprises.api.gouv.fr https://api.github.com; object-src 'none'; base-uri 'none'; frame-ancestors 'self'; form-action 'self'

# ══════════════════════════════════════════════════════════════════════
#  /admin — l'éditeur de contenu Sveltia.
#
#  Cette règle vient APRÈS /* et l'emporte sur elle pour ce seul chemin :
#  la politique du site reste inchangée pour les 100 pages publiques.
#
#  Ce qui est ouvert ici, et pourquoi :
#   · cdn.jsdelivr.net — le paquet de l'éditeur, ses polices et ses icônes
#   · unpkg.com        — l'éditeur y lit son package.json pour se dire à jour
#   · api.github.com   — lecture et écriture du dépôt, c'est le cœur du métier
#   · githubstatus.com — l'éditeur prévient quand GitHub est en panne plutôt
#                        que d'échouer sans explication
#   · data: et blob:   — aperçus d'images et rendu hors ligne
#
#  Rien d'autre. Pas de wildcard, pas de 'unsafe' supplémentaire.
# ══════════════════════════════════════════════════════════════════════
/admin/*
  X-Robots-Tag: noindex, nofollow
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src 'self' data: https://cdn.jsdelivr.net; img-src 'self' data: blob: https:; connect-src 'self' data: blob: https://cdn.jsdelivr.net https://unpkg.com https://api.github.com https://www.githubstatus.com https://*.maxime-ead.workers.dev; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; frame-ancestors 'self'; form-action 'self' https://github.com
